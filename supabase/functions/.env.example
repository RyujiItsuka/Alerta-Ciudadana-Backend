# Secretos de las Edge Functions para el entorno LOCAL (supabase start).
# Copiar a supabase/functions/.env (ignorado por Git) y completar.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta la
# CLI automáticamente: no hace falta definirlos.

# Firma de los JWT propios (ciudadano y personal). En local, cualquier valor
# largo y aleatorio; NUNCA el de producción.
JWT_SECRET_KEY=

# Green API: se dejan VACÍOS a propósito para que en local no se envíen
# WhatsApp reales. La función whatsapp responderá "no configurado" y send-otp
# devolverá 502 (comportamiento esperado en local).
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Clave de cifrado de la caché de RENIEC (cualquier valor aleatorio en local).
RENIEC_CACHE_KEY=
